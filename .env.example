# 從 Discord Developer Portal 取得
DISCORD_TOKEN=你的機器人Token

# 注意：BOOKING_PARENT_CHANNEL_ID / ADMIN_CHANNEL_ID / MANAGEMENT_CHANNEL_ID / ANNOUNCEMENT_CHANNEL_ID
# 這四個頻道設定已經改成存在資料庫的 guild_settings 表裡（每個語音群各自一份），
# 不再從這裡讀取。新增/修改語音群設定請用 scripts/add-guild.js，詳見 MULTI-GUILD.md

# ---- 班表翻頁（單一訊息 + 翻頁）、衝突建議空檔：以下都可以不設，沒設定就用預設值 ----
# 班表閒置幾分鐘沒人操作，就自動回到「現在時間之後」那一頁（預設 10）
# PAGE_IDLE_MINUTES=10
# 多久檢查一次有沒有班表該復位，單位秒（預設 300 = 5 分鐘）
# PAGE_IDLE_CHECK_SECONDS=300
# 時段衝突時建議的空檔，至少要比「現在」晚幾分鐘（預設 5；設 0 代表下一分鐘起都可以建議）
# SUGGEST_MIN_LEAD_MINUTES=5
